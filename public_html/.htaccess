# Never let the web server hand out DB dumps, logs, config or backup files
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|log|env|ini|bak|zip|gz|tar|rnd)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Prevent directory index listings safely
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# URL rewriting for extensionless PHP URLs
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect internal include folders
    RewriteRule ^db/ - [F,L]
    RewriteRule ^posting/includes/ - [F,L]

    # Fix relative asset requests under /v/
    RewriteRule ^v/(upload|images|build|vendors)/(.*)$ $1/$2 [L,NC]

    # Secure ID verification route: /v/<32-char-hash>
    RewriteRule ^v/([a-zA-Z0-9_-]{16,64})/?$ employee.php?h=$1 [QSA,L]
    RewriteRule ^v/?$ employee.php [QSA,L]

    # Clean URL handling (.php extension stripping)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,QSA,L]
</IfModule>
