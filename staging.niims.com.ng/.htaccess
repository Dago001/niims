# Never let the web server hand out DB dumps, logs, config or backup files
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|log|env|ini|bak|zip|gz|tar|rnd)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Prevent directory index listings safely
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# URL rewriting for extensionless PHP URLs
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect internal include folders
    RewriteRule ^db/ - [F,L]
    RewriteRule ^posting/includes/ - [F,L]

    # Clean URL handling (.php extension stripping)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,QSA,L]
</IfModule>

